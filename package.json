{
  "name": "pt-ai-lms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "test:db": "node --env-file-if-exists=.env.local scripts/run-db-tests.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/apply-migrations.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/run-db-seed.mjs",
    "db:seed:users": "node --env-file-if-exists=.env.local scripts/seed-dev-users.mjs",
    "db:seed:academics": "node --env-file-if-exists=.env.local scripts/seed-dev-academics.mjs",
    "data:retention": "node --env-file-if-exists=.env.local scripts/apply-retention.mjs",
    "ai:index": "node --env-file-if-exists=.env.local scripts/index-ai-sources.mjs",
    "ai:check": "node --env-file-if-exists=.env.local scripts/check-ai-pipeline.mjs",
    "check:sql": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/check-sql-consistency.ps1",
    "check:secrets": "node --env-file-if-exists=.env.local scripts/check-client-secrets.mjs",
    "check:headers": "node scripts/check-security-headers.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@google/genai": "^2.19.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
