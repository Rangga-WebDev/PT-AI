# ================================================================
# PT-AI LMS — Contoh konfigurasi environment
# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN pernah meng-commit .env.local atau nilai secret apa pun.
# ================================================================

# --- Supabase (digunakan mulai PHASE 4-5) ---
# URL project Supabase (bukan secret).
NEXT_PUBLIC_SUPABASE_URL=
# Anon/publishable key (bukan secret; akses data dilindungi RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (SECRET — DILARANG memakai prefix NEXT_PUBLIC_) ---
# Service role key Supabase; hanya boleh dibaca modul server-only
# (src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=
# API key Gemini; hanya boleh dibaca AI provider adapter server-only.
# Ambil dari https://aistudio.google.com/apikey (LOCK-TECH-022 rev. CR-001).
GEMINI_API_KEY=

# --- Hanya untuk menjalankan test database (npm run test:db) ---
# Cukup isi SALAH SATU. Tidak dipakai aplikasi Next.js.
# (a) Password database saja; host diambil dari hasil `supabase link`:
SUPABASE_DB_PASSWORD=
# (b) Atau connection string penuh dari Dashboard -> Connect -> Session pooler:
DATABASE_URL=
